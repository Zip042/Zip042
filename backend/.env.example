# ---------------------------------------------------------------------------
# ZIP 042 백엔드 환경변수
# ---------------------------------------------------------------------------
#
# 프론트엔드 개발 중이라면 이 파일이 필요 없습니다. `npm run dev:mock` 으로 바로 실행되며
# 외부 API를 전혀 호출하지 않습니다. 자세한 내용은 README 0절 참고.
#
# 실행 모드: live | mock
#   비워두면 SUPABASE_URL 유무로 자동 판단합니다 (없으면 mock).
#   NODE_ENV=production 에서 mock 은 부팅이 차단됩니다.
ZIP042_MODE=

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# 관리자 디버그 콘솔 (http://localhost:8787/v1/_debug)
# 어떤 요청이 오고 무엇을 돌려줬는지, 외부 API 가 실제로 불렸는지 한 화면에서 봅니다.
# ⚠️ 판독한 실제 주소·이름이 남습니다. 로컬에서만 켜세요 —
#    NODE_ENV=production 에서 켜면 부팅이 차단됩니다.
ZIP042_DEBUG_CONSOLE=false

# 프론트엔드 개발 서버 주소 (콤마 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# --- Supabase (live 모드에서만 필수) -------------------------------------
# Supabase 대시보드 > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 레거시 HS256 프로젝트만 필요. 비대칭 키(JWKS)를 쓰면 비워둔다.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=case-documents

# --- Anthropic (문서 판독) -------------------------------------------------
# live 모드에서 없으면 문서 판독이 비활성화되고, 분석은 나머지 정보로만 진행된다.
# 목 모드에서는 픅스처를 쓰므로 필요 없다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high  (설치된 SDK 0.71.x 기준)
ANTHROPIC_EFFORT=high

# --- 공공데이터포털 (실거래가 시세) ----------------------------------------
# https://www.data.go.kr — 국토교통부 실거래가 API 활용신청 후 발급받은 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_BASE_URL=https://apis.data.go.kr

# --- 법제처 국가법령정보 공동활용 (계약서 초안 · 특약 법조문 인용) --------
# https://open.law.go.kr — 이메일 인증으로 OC 키 발급
LAW_GO_KR_OC=

# --- 한국천문연구원 특일 정보 (공휴일 동기화) ------------------------------
# 설정 후 POST /v1/admin/holidays/sync 를 1회 실행해야 음력 연휴가 반영된다.
KASI_SERVICE_KEY=

# --- 지역 위험 레이어 ------------------------------------------------------
REGION_RISK_RADIUS_M=500

# --- 관리자 배치 / 개인정보 보호 -------------------------------------------
# 32자 이상 랜덤 문자열: openssl rand -hex 24
ADMIN_API_TOKEN=
# 소유자 이름 매칭용 HMAC 페퍼. 없으면 동일 소유자 탐지가 비활성화된다.
# openssl rand -hex 32
MATCH_KEY_PEPPER=

# --- 주소 검색 / 지오코딩 --------------------------------------------------
# 둘 중 하나만 있으면 된다. 없으면 목 데이터로 폴백하고 /v1/meta 로 알린다.
# ⚠️ 카카오 응답의 b_code(법정동코드)를 써야 한다. h_code(행정동)는 실거래가 조회에 안 맞는다.
KAKAO_REST_API_KEY=
VWORLD_API_KEY=

# --- 목 모드 전용 ----------------------------------------------------------
# 목 모드의 서명 업로드 URL이 가리킬 주소. 비우면 http://localhost:{PORT}
PUBLIC_BASE_URL=

# ===========================================================================
# 공공 API — 팀 확정 목록 (집톡 필요 API 요약, 2026-08)
#
# 아래 순서대로 신청하세요. 위에서부터 의존 관계가 있습니다.
# 키를 채운 뒤 `npm run preflight` 를 돌리면 각각 실제 호출 1회로 확인합니다.
# ===========================================================================

# --- 1순위. 이게 없으면 실거래가 API 가 전부 안 돕니다 ---------------------
# 행정안전부 도로명주소 개발자센터 — 주소 정규화 + 법정동코드(LAWD_CD)
#   https://business.juso.go.kr
# ⚠️ 신청 시 '사용 URL' 에 http://localhost 를 꼭 포함하세요.
#    안 넣으면 로컬에서 E0005 가 나는데, 키가 틀린 것으로 오해하기 쉽습니다.
JUSO_CONFM_KEY=

# --- 2순위. 판독 모델 (둘 중 하나면 됩니다) --------------------------------
# auto = 키가 있는 쪽을 씁니다. 둘 다 있으면 anthropic 우선.
LLM_PROVIDER=auto
# Google Gemini  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- 3순위. 공공데이터포털 (계정 공통 키 하나로 대부분 됩니다) --------------
# 아래 개별 키는 기관이 별도 키를 준 경우에만 채우세요. 비우면 공통 키를 씁니다.
#
#   실거래가 8종   아파트 매매 15126469 · 아파트 전월세 15126474
#                  연립다세대 매매 15126467 · 연립다세대 전월세 15126473
#                  단독다가구 전월세 15126472 · 오피스텔 전월세 15126475
MOLIT_RTMS_SERVICE_KEY=
#   건축HUB 건축물대장 15134735 — 위반건축물 자동 확인
MOLIT_BUILDING_LEDGER_KEY=
#   한국부동산원 부동산통계 15134761 — 전세가율 통계 보정
REB_STATS_SERVICE_KEY=
#   국세청 사업자등록 진위확인 15081808 — 법인 임대인 실재·휴폐업
NTS_BIZ_SERVICE_KEY=
