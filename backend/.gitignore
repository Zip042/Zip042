# 의존성 · 빌드 산출물
node_modules/
dist/

# ---------------------------------------------------------------------------
# 비밀 값 — 절대 커밋하지 않는다
#
# ⚠️ 저장소에 키를 한 번 커밋하면 히스토리에서 지우기 어렵고, 공개 저장소라면
#    즉시 유출된 것으로 봐야 한다(자동 스캐너가 몇 분 안에 긁어간다).
#    새 키 파일을 만들 때는 반드시 아래 패턴에 걸리는 이름을 쓸 것.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.key
*.key
*.pem
secrets/
credentials*.json
service-account*.json

# 도구
.vercel
supabase/.temp/
*.log

# OS
.DS_Store
Thumbs.db

# public/ 은 무시하지 않는다. vercel.json 의 outputDirectory 가 이 폴더를 가리키므로
# 저장소에 없으면 배포가 "No Output Directory" 로 실패한다. 빌드 산출물이 아니라
# 설정을 만족시키기 위한 안내 파일 하나뿐이다.

# 브이월드 공동주택가격정보 원본(zip, 수백KB~MB 단위, 로그인해야 받을 수 있음).
# scripts/import-housing-price.ts 가 이걸 읽어 daejeon.json 으로 바꾼다.
# 커밋하는 건 daejeon.json 뿐이다 — 원본은 반기마다 사람이 다시 받는다.
data/housing-price/*.zip
