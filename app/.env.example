# ZIP 042 프론트엔드 설정
#
# 이 파일을 .env 로 복사해서 쓰세요. .env 는 커밋하지 않습니다.

# --- 백엔드 주소 -----------------------------------------------------------
# 개발 중에는 이것만 있으면 됩니다. vite dev 서버가 /v1 요청을 이 주소로 넘깁니다(프록시).
# 브라우저 입장에서는 같은 오리진이라 CORS 문제가 생기지 않습니다.
VITE_BACKEND_ORIGIN=http://localhost:8787

# --- 배포용 ----------------------------------------------------------------
# 브라우저가 백엔드를 **직접** 부르게 하려면 이 값을 채웁니다(프록시를 타지 않습니다).
# 이 경우 백엔드의 CORS_ORIGINS 에 프론트 주소를 넣어야 합니다.
# 비워 두면 상대경로(/v1)를 씁니다.
VITE_API_BASE_URL=
